generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deal {
  id String @id @default(cuid())

  // true when outbound and return are different carriers (UI: "two separate tickets")
  mixedCarrier Boolean @default(false)

  // true when return airport differs from origin (open-jaw); false = classic round-trip
  openJaw      Boolean @default(false)

  // Outbound leg
  originAirport String
  originCountry String
  departAt      DateTime

  // Destination
  destAirport  String
  destCountry  String
  returnAt     DateTime

  // Return airport (same as originAirport for round-trips; different Polish airport for open-jaw)
  returnAirport String @default("")

  nights Int

  // Total price (outbound + return, per 1 person)
  totalPrice     Float
  currency       String @default("PLN")
  pricePerPerson Float

  // Outbound leg — independent carrier
  outboundSource     String
  outboundAirline    String
  outboundPrice      Float
  outboundFlightNo   String?
  outboundStops      Int     @default(0)
  outboundBookingUrl String?

  // Return leg — independent carrier (may differ from outbound)
  returnSource     String
  returnAirline    String
  returnPrice      Float
  returnFlightNo   String?
  returnStops      Int     @default(0)
  returnBookingUrl String?

  foundAt   DateTime @default(now())
  expiresAt DateTime

  @@unique([originAirport, destAirport, departAt, returnAt, outboundSource, returnSource, returnAirport])
  @@index([destCountry, totalPrice])
  @@index([expiresAt])
  @@index([departAt])
}

// Cheapest Rainbow (r.pl) charter offer per destination, latest snapshot only
model CharterOffer {
  destIata         String    @id // r.pl "Klucz"
  destName         String // e.g. "Kreta - Heraklion"
  destNameUrl      String // r.pl URL slug, e.g. "heraklion"
  destCountry      String // Polish country name from API, e.g. "Grecja"
  destCountryUrl   String // r.pl URL slug, e.g. "grecja"
  priceRoundTrip   Float? // cheapest round-trip per person (oneWay=false); null if not offered
  priceOneWay      Float? // cheapest one-way per person (oneWay=true); null if not offered
  nearestDeparture DateTime?
  baggageKg        Int?
  imageUrl         String?
  // Cheapest concrete flight per mode (date, departure airport, times, airline…)
  // Shape: engine's CheapestFlight — { date, depAirport, depIata, depTime, arrTime, airline, flightNo, price }
  rtFlight         Json?
  owFlight         Json?
  updatedAt        DateTime  @updatedAt

  @@index([priceRoundTrip])
}

// Every concrete Rainbow charter flight (both pricing modes), latest snapshot only.
// oneWay=false rows carry the outbound price as part of a round-trip package.
model CharterFlight {
  id             String   @id @default(cuid())
  oneWay         Boolean
  destIata       String
  destName       String
  destNameUrl    String
  destCountry    String
  destCountryUrl String
  imageUrl       String?
  date           DateTime // departure date (UTC midnight)
  depTime        String // HH:MM local
  arrTime        String
  depIata        String
  depAirport     String
  airline        String
  flightNo       String?
  flightTime     String?
  baggageKg      Int?
  price          Float // per person; oneWay=false → outbound part of the package
  pakietId       String? // r.pl package id — deep link idWylot

  // Return leg (oneWay=false only) — charter packages have exactly one return
  // day per outbound, so a row is a complete round trip.
  returnDate    DateTime?
  retDepTime    String? // departure from destination, HH:MM
  retArrTime    String?
  retArrIata    String?
  retArrAirport String?
  retAirline    String?
  retFlightNo   String?
  returnPrice   Float?
  retPakietId   String? // deep link idPrzylot
  nights        Int?
  totalPrice    Float? // oneWay=true → price; oneWay=false → price + returnPrice (null if pairing failed)

  updatedAt DateTime @updatedAt

  @@index([oneWay, totalPrice])
  @@index([oneWay, price])
  @@index([destCountry])
  @@index([depIata])
  @@index([date])
}

// Cheapest Ryanair one-way fare per route and day within the rolling
// last-minute window (today → +10 days), both directions, latest snapshot only.
model OneWayFare {
  id            String   @id @default(cuid())
  direction     String // "OUT" = from Poland | "IN" = to Poland
  origin        String // IATA
  originCity    String
  originCountry String // Polish country name, e.g. "Hiszpania"
  destination   String // IATA
  destCity      String
  destCountry   String
  date          DateTime // flight day (UTC midnight)
  departureTime DateTime // local wall-clock stored as-is
  arrivalTime   DateTime
  flightNumber  String?
  price         Float // per person, PLN
  currency      String   @default("PLN")
  updatedAt     DateTime @updatedAt

  @@unique([origin, destination, date])
  @@index([direction, price])
  @@index([direction, date])
}

model Airport {
  iata     String  @id
  name     String  // city name in Polish (from Ryanair /pl/ locale)
  country  String  // 2-letter ISO code
  isPolish Boolean @default(false)
}

model AirportRoute {
  fromIata String
  toIata   String
  @@id([fromIata, toIata])
  @@index([fromIata])
}

model AirportSync {
  id       String   @id
  syncedAt DateTime
}

model CityImage {
  city     String   @id // city name as returned by Ryanair API
  imageUrl String   // Unsplash small URL
  cachedAt DateTime
}

model RouteCache {
  id      String   @id // always "main"
  savedAt DateTime
  routes  Json     // Array<{origin: string, destination: string}>
  destMap Json     // Array<{dest: string, options: Array<{airport: string, level: 1|2|3}>}>
}

model SearchRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String    // "SUCCESS" | "FAILED" | "PARTIAL"
  dealsFound    Int       @default(0)
  routesQueried Int       @default(0)
  errorMessage  String?

  @@index([startedAt])
}
