generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deal {
  id String @id @default(cuid())

  // true when outbound and return are different carriers (UI: "two separate tickets")
  mixedCarrier Boolean @default(false)

  // true when return airport differs from origin (open-jaw); false = classic round-trip
  openJaw      Boolean @default(false)

  // Outbound leg
  originAirport String
  originCountry String
  departAt      DateTime

  // Destination
  destAirport  String
  destCountry  String
  returnAt     DateTime

  // Return airport (same as originAirport for round-trips; different Polish airport for open-jaw)
  returnAirport String @default("")

  nights Int

  // Total price (outbound + return, per 1 person)
  totalPrice     Float
  currency       String @default("PLN")
  pricePerPerson Float

  // Outbound leg — independent carrier
  outboundSource     String
  outboundAirline    String
  outboundPrice      Float
  outboundFlightNo   String?
  outboundStops      Int     @default(0)
  outboundBookingUrl String?

  // Return leg — independent carrier (may differ from outbound)
  returnSource     String
  returnAirline    String
  returnPrice      Float
  returnFlightNo   String?
  returnStops      Int     @default(0)
  returnBookingUrl String?

  foundAt   DateTime @default(now())
  expiresAt DateTime

  @@unique([originAirport, destAirport, departAt, returnAt, outboundSource, returnSource, returnAirport])
  @@index([destCountry, totalPrice])
  @@index([expiresAt])
  @@index([departAt])
}

// Cheapest Rainbow (r.pl) charter offer per destination, latest snapshot only
model CharterOffer {
  destIata         String    @id // r.pl "Klucz"
  destName         String // e.g. "Kreta - Heraklion"
  destNameUrl      String // r.pl URL slug, e.g. "heraklion"
  destCountry      String // Polish country name from API, e.g. "Grecja"
  destCountryUrl   String // r.pl URL slug, e.g. "grecja"
  priceRoundTrip   Float? // cheapest round-trip per person (oneWay=false); null if not offered
  priceOneWay      Float? // cheapest one-way per person (oneWay=true); null if not offered
  nearestDeparture DateTime?
  baggageKg        Int?
  imageUrl         String?
  updatedAt        DateTime  @updatedAt

  @@index([priceRoundTrip])
}

model Airport {
  iata     String  @id
  name     String  // city name in Polish (from Ryanair /pl/ locale)
  country  String  // 2-letter ISO code
  isPolish Boolean @default(false)
}

model AirportRoute {
  fromIata String
  toIata   String
  @@id([fromIata, toIata])
  @@index([fromIata])
}

model AirportSync {
  id       String   @id
  syncedAt DateTime
}

model CityImage {
  city     String   @id // city name as returned by Ryanair API
  imageUrl String   // Unsplash small URL
  cachedAt DateTime
}

model RouteCache {
  id      String   @id // always "main"
  savedAt DateTime
  routes  Json     // Array<{origin: string, destination: string}>
  destMap Json     // Array<{dest: string, options: Array<{airport: string, level: 1|2|3}>}>
}

model SearchRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String    // "SUCCESS" | "FAILED" | "PARTIAL"
  dealsFound    Int       @default(0)
  routesQueried Int       @default(0)
  errorMessage  String?

  @@index([startedAt])
}
